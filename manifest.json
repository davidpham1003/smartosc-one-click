{
  "manifest_version": 3,
  "name": "SmartOSC - One Click",
  "version": "1.0.0",
  "author": "LuongPQ",
  "minimum_chrome_version": "114",
  "description": "Just one click for your daily SmartOSC routine: log work on SRA and register attendance on Zoho People. (by LuongPQ)",
  "permissions": ["sidePanel", "scripting", "tabs"],
  "host_permissions": [
    "https://naloheesgmmtrjlxqwii.supabase.co/*",
    "https://sra.smartosc.com/*",
    "https://people.zoho.com/*",
    "https://people.smartosc.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "SmartOSC - One Click",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
